<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hbcy.authcenter.api.modules.core.tenant.dao.TenantAppResourceMapper">
    <resultMap id="BaseResultMap" type="com.hbcy.authcenter.api.modules.core.tenant.model.TenantAppResource">
        <!--@mbg.generated-->
        <!--@Table tenant_app_resource-->
        <id column="id" jdbcType="CHAR" property="id"/>
        <result column="tenant_id" jdbcType="VARCHAR" property="tenantId"/>
        <result column="app_id" jdbcType="VARCHAR" property="appId"/>
        <result column="perm_id" jdbcType="CHAR" property="permId"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="create_user" jdbcType="CHAR" property="createUser"/>
        <result column="update_user" jdbcType="CHAR" property="updateUser"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        tenant_id,
        app_id,
        perm_id,
        create_time,
        update_time,
        create_user,
        update_user
    </sql>

    <select id="getGrantedPermIds" resultType="java.lang.String">
        select perm_id
        from tenant_app_resource
        where tenant_id = #{tenantId}
        <if test="appId != null and appId != ''">
            and app_id = #{appId}
        </if>
    </select>
</mapper>