<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hbcy.authcenter.api.modules.minor.todo.dao.UserTodoMapper">
    <resultMap id="BaseResultMap" type="com.hbcy.authcenter.api.modules.minor.todo.model.UserTodo">
        <!--@mbg.generated-->
        <!--@Table user_todo-->
        <id column="id" jdbcType="CHAR" property="id"/>
        <result column="src_app" jdbcType="VARCHAR" property="srcApp"/>
        <result column="src_id" jdbcType="VARCHAR" property="srcId"/>
        <result column="todo_title" jdbcType="VARCHAR" property="todoTitle"/>
        <result column="todo_content" jdbcType="VARCHAR" property="todoContent"/>
        <result column="target_user" jdbcType="CHAR" property="targetUser"/>
        <result column="send_time" jdbcType="TIMESTAMP" property="sendTime"/>
        <result column="process_state" jdbcType="TINYINT" property="processState"/>
        <result column="view_state" jdbcType="TINYINT" property="viewState"/>
        <result column="todo_type" jdbcType="TINYINT" property="todoType"/>
        <result column="relate_link" jdbcType="VARCHAR" property="relateLink"/>
        <result column="origin_json" jdbcType="LONGVARCHAR" property="originJson"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        src_app,
        src_id,
        todo_title,
        todo_content,
        target_user,
        send_time,
        process_state,
        view_state,
        todo_type,
        relate_link,
        origin_json,
        create_time,
        update_time
    </sql>

    <!--    TODO: MySQL Only-->
    <insert id="insertIgnore">
        insert ignore into user_todo (id, src_app, src_id, todo_title, todo_content, target_user,
        send_time, process_state, todo_type, relate_link, origin_json)
        values
        <foreach collection="todos" item="todo" separator=",">
            (#{todo.id}, #{todo.srcApp}, #{todo.srcId}, #{todo.todoTitle}, #{todo.todoContent}, #{todo.targetUser},
            #{todo.sendTime}, #{todo.processState}, #{todo.todoType}, #{todo.relateLink}, #{todo.originJson})
        </foreach>
    </insert>

    <select id="query" resultType="com.hbcy.authcenter.api.modules.minor.todo.dto.UserTodoDTO">
        select id,
        src_app,
        todo_title,
        todo_content,
        send_time,
        view_state,
        process_state,
        todo_type,
        relate_link
        from user_todo
        <where>
            target_user = #{vo.userId}
            <if test="vo.keyword != null and vo.keyword != ''">
                and todo_title like concat('%', #{vo.keyword}, '%')
            </if>
            <if test="vo.todoType != null">
                and todo_type = #{vo.todoType}
            </if>
            <if test="vo.processState != null">
                and process_state = #{vo.processState}
            </if>
            <if test="vo.viewState != null">
                and view_state = #{vo.viewState}
            </if>
            <if test="vo.sendTimeStart != null">
                and send_time &gt;= #{vo.sendTimeStart}
            </if>
            <if test="vo.sendTimeEnd != null">
                and #{vo.sendTimeEnd} &gt;= send_time
            </if>
            <if test="vo.srcApp != null">
                and src_app = #{vo.srcApp}
            </if>
        </where>
        order by id desc
    </select>
</mapper>