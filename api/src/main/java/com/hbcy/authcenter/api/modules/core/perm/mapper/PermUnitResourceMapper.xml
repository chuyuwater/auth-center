<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hbcy.authcenter.api.modules.core.perm.dao.PermUnitResourceMapper">
    <resultMap id="BaseResultMap" type="com.hbcy.authcenter.api.modules.core.perm.model.PermUnitResource">
        <!--@mbg.generated-->
        <!--@Table perm_unit_resource-->
        <id column="id" property="id"/>
        <result column="unit_id" property="unitId"/>
        <result column="app_id" property="appId"/>
        <result column="perm_id" property="permId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user" property="createUser"/>
        <result column="update_user" property="updateUser"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        unit_id,
        app_id,
        perm_id,
        tenant_id,
        create_user,
        update_user,
        create_time,
        update_time
    </sql>

    <select id="listGrantedApps" resultType="java.lang.String">
        select distinct app_id
        from perm_unit_resource
        where unit_id = #{unitId}
    </select>

    <select id="listGrantPermIds" resultType="java.lang.String">
        select perm_id
        from perm_unit_resource
        where unit_id = #{unitId}
    </select>

    <select id="selectUnitApp" resultType="com.hbcy.authcenter.api.modules.core.perm.dto.PermUnitAppDTO">
        select distinct pur.unit_id, pur.app_id, app.name_cn as app_name
        from perm_unit_resource pur
        join app on pur.app_id = app.id
        <where>
            pur.unit_id in
            <foreach collection="unitIds" open="(" item="item" close=")" separator=",">
                #{item}
            </foreach>
        </where>
    </select>
</mapper>