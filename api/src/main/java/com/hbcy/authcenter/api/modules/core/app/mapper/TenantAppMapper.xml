<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hbcy.authcenter.api.modules.core.app.dao.TenantAppMapper">
    <resultMap id="BaseResultMap" type="com.hbcy.authcenter.api.modules.core.app.model.TenantApp">
        <!--@mbg.generated-->
        <!--@Table tenant_app-->
        <id column="id" jdbcType="CHAR" property="id"/>
        <result column="app_id" jdbcType="VARCHAR" property="appId"/>
        <result column="tenant_id" jdbcType="VARCHAR" property="tenantId"/>
        <result column="org_tree" jdbcType="VARCHAR" property="orgTree"/>
        <result column="forbidden" jdbcType="TINYINT" property="forbidden"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="create_user" jdbcType="CHAR" property="createUser"/>
        <result column="update_user" jdbcType="CHAR" property="updateUser"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id, app_id, tenant_id, org_tree, forbidden, create_time, update_time, create_user,
        update_user
    </sql>

    <select id="listBindApps" resultType="com.hbcy.authcenter.api.modules.core.app.dto.AppCardDTO">
        select app.id as app_id, app.name_cn, app.memo, tenant_app.forbidden
        from app
        join tenant_app on tenant_app.app_id = app.id
        <where>
            app.forbidden = 0 and tenant_app.tenant_id = #{tenantId}
        </where>
        order by app.show_order
    </select>
</mapper>