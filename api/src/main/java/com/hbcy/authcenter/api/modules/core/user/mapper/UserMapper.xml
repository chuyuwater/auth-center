<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hbcy.authcenter.api.modules.core.user.dao.UserMapper">
    <resultMap id="BaseResultMap" type="com.hbcy.authcenter.api.modules.core.user.model.User">
        <!--@mbg.generated-->
        <!--@Table sys_user-->
        <id column="id" jdbcType="CHAR" property="id"/>
        <result column="phone" jdbcType="VARCHAR" property="phone"/>
        <result column="account" jdbcType="VARCHAR" property="account"/>
        <result column="real_name" jdbcType="VARCHAR" property="realName"/>
        <result column="passwd" jdbcType="VARCHAR" property="passwd"/>
        <result column="email" jdbcType="VARCHAR" property="email"/>
        <result column="avatar" jdbcType="VARCHAR" property="avatar"/>
        <result column="forbidden" jdbcType="TINYINT" property="forbidden"/>
        <result column="wecom_id" jdbcType="VARCHAR" property="wecomId"/>
        <result column="src_type" jdbcType="TINYINT" property="srcType"/>
        <result column="src_id" jdbcType="VARCHAR" property="srcId"/>
        <result column="passwd_expire" jdbcType="TIMESTAMP" property="passwdExpire"/>
        <result column="tenant_id" jdbcType="VARCHAR" property="tenantId"/>
        <result column="last_login" jdbcType="TIMESTAMP" property="lastLogin"/>
        <result column="delete_time" jdbcType="BIGINT" property="deleteTime"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="create_user" jdbcType="CHAR" property="createUser"/>
        <result column="update_user" jdbcType="CHAR" property="updateUser"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        phone,
        account,
        real_name,
        passwd,
        email,
        avatar,
        forbidden,
        wecom_id,
        src_type,
        src_id,
        passwd_expire,
        tenant_id,
        last_login,
        delete_time,
        create_time,
        update_time,
        create_user,
        update_user
    </sql>


    <select id="selectNameByIds" resultType="com.hbcy.common.web.api.NamedId">
        select id as item_id, real_name as item_name
        from sys_user
        <where>
            id in
            <foreach collection="uids" open="(" close=")" item="u" separator=",">
                #{u}
            </foreach>
        </where>
    </select>

    <select id="selectNameById" resultType="java.lang.String">
        select real_name
        from sys_user
        where id = #{userId}
    </select>

    <select id="queryUser" resultType="com.hbcy.authcenter.api.modules.core.user.dto.UserQueryResultDTO">
        select u.id,
        u.phone,
        u.account,
        u.real_name,
        u.email,
        u.avatar,
        u.forbidden,
        u.create_time,
        u.create_user,
        u.update_time,
        u.update_user
        from sys_user u
        join user_org uo on uo.user_id = u.id
        join org_tree o on uo.node_id = o.id
        <where>
            u.delete_time = 0
            <if test="vo.tenantId != null and vo.tenantId != ''">
                and uo.tenant_id = #{vo.tenantId}
            </if>
            <if test="vo.keywordType != null and !vo.keywordType.empty">
                and(
                <trim prefixOverrides="or">
                    <if test="vo.keywordType.contains('PHONE')">
                        or u.phone like concat(#{vo.keyword}, '%')
                    </if>
                    <if test="vo.keywordType.contains('ACCOUNT')">
                        or u.account like concat(#{vo.keyword}, '%')
                    </if>
                    <if test="vo.keywordType.contains('NAME')">
                        or u.real_name like concat(#{vo.keyword}, '%')
                    </if>
                </trim>
                )
            </if>
            <if test="vo.forbidden != null">
                and u.forbidden = #{vo.forbidden}
            </if>
            <if test="vo.nodeId != null and vo.nodeId != ''">
                and o.id = #{vo.nodeId}
            </if>
            <if test="vo.mainJob != null">
                and uo.main_job = #{vo.mainJob}
            </if>
            <if test="vo.idPathPrefix != null and vo.idPathPrefix != ''">
                and o.id_path like concat(#{vo.idPathPrefix}, '%')
            </if>
            <if test="vo.userId != null and vo.userId != ''">
                and uo.user_id = #{vo.userId}
            </if>
        </where>
    </select>

    <select id="filterUser4Select" resultType="com.hbcy.authcenter.api.modules.core.user.dto.OrgUserDTO">
        select u.id,
        u.phone,
        u.account,
        u.real_name,
        u.email,
        u.avatar,
        u.forbidden,
        uo.node_id,
        uo.main_job,
        uo.main_job,
        o.id_path
        from user_org uo
        join sys_user u on uo.user_id = u.id
        join org_tree o on uo.node_id = o.id
        <where>
            u.forbidden = 0
            and u.delete_time = 0
            and uo.tenant_id = #{vo.tenantId}
            <if test="vo.keywordType != null and !vo.keywordType.empty">
                and(
                <trim prefixOverrides="or">
                    <if test="vo.keywordType.contains('PHONE')">
                        or u.phone like concat(#{vo.keyword}, '%')
                    </if>
                    <if test="vo.keywordType.contains('ACCOUNT')">
                        or u.account like concat(#{vo.keyword}, '%')
                    </if>
                    <if test="vo.keywordType.contains('NAME')">
                        or u.real_name like concat(#{vo.keyword}, '%')
                    </if>
                </trim>
                )
            </if>
            <if test="vo.nodeId != null and vo.nodeId != ''">
                and o.id = #{vo.nodeId}
            </if>
            <if test="vo.mainJob != null">
                and uo.main_job = #{vo.mainJob}
            </if>
            <if test="vo.idPathPrefix != null and vo.idPathPrefix != ''">
                and o.id_path like concat(#{vo.idPathPrefix}, '%')
            </if>
        </where>
    </select>
</mapper>