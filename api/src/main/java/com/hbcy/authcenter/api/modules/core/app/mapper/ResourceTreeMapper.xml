<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hbcy.authcenter.api.modules.core.app.dao.ResourceTreeMapper">
    <resultMap id="BaseResultMap" type="com.hbcy.authcenter.api.modules.core.app.model.ResourceTree">
        <!--@mbg.generated-->
        <!--@Table resource_tree-->
        <id column="id" jdbcType="CHAR" property="id"/>
        <result column="name_cn" jdbcType="VARCHAR" property="nameCn"/>
        <result column="app_id" jdbcType="VARCHAR" property="appId"/>
        <result column="custom_id" jdbcType="VARCHAR" property="customId"/>
        <result column="parent_id" jdbcType="CHAR" property="parentId"/>
        <result column="id_path" jdbcType="VARCHAR" property="idPath"/>
        <result column="client_type" jdbcType="TINYINT" property="clientType"/>
        <result column="icon" jdbcType="VARCHAR" property="icon"/>
        <result column="route_link" jdbcType="VARCHAR" property="routeLink"/>
        <result column="show_order" jdbcType="INTEGER" property="showOrder"/>
        <result column="hidden" jdbcType="TINYINT" property="hidden"/>
        <result column="show_level" jdbcType="TINYINT" property="showLevel"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="create_user" jdbcType="CHAR" property="createUser"/>
        <result column="update_user" jdbcType="CHAR" property="updateUser"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        name_cn,
        app_id,
        custom_id,
        parent_id,
        id_path,
        client_type,
        icon,
        route_link,
        show_order,
        hidden,
        show_level,
        create_time,
        update_time,
        create_user,
        update_user
    </sql>

    <select id="listChildren" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from resource_tree
        <where>
            app_id = #{vo.appId}
            <if test="vo.idPath != null and vo.idPath != ''">
                and id_path like concat(#{vo.idPath}, '%')
            </if>
            <if test="vo.clientType != null">
                <choose>
                    <when test="vo.clientType == 1">
                        and client_type in (0, 1)
                    </when>
                    <when test="vo.clientType == 2">
                        and client_type in (0, 2)
                    </when>
                </choose>
            </if>
            <if test="vo.showLevel != null">
                <choose>
                    <when test="vo.showLevel == 1">
                        and show_level in (0, 1)
                    </when>
                    <when test="vo.showLevel == 2">
                        and show_level in (0, 2)
                    </when>
                </choose>
            </if>
            <if test="vo.withHidden != null and !vo.withHidden">
                and hidden = 0
            </if>
            <if test="vo.keyword != null and vo.keyword != ''">
                and (
                name_cn like concat('%', #{vo.keyword}, '%')
                or custom_id like concat('%', #{vo.keyword}, '%')
                )
            </if>
        </where>
    </select>

    <insert id="append">
        insert into resource_tree (id, name_cn, app_id, custom_id, parent_id, id_path, client_type, icon, route_link,
        hidden, show_level, create_user, update_user,
        show_order)
        select #{entity.id},
        #{entity.nameCn},
        #{entity.appId},
        #{entity.customId},
        #{entity.parentId},
        #{entity.idPath},
        #{entity.clientType},
        #{entity.icon},
        #{entity.routeLink},
        #{entity.hidden},
        #{entity.showLevel},
        #{entity.createUser},
        #{entity.updateUser},
        (SELECT COALESCE(MAX(show_order), 0) + 1 from
        resource_tree where parent_id = #{entity.parentId} and app_id= #{entity.appId})
    </insert>

    <update id="updateIdPath">
        update resource_tree
        set id_path = replace(id_path, #{oldPath}, #{newPath})
        where app_id = #{appId}
        and id_path like concat(#{oldPath}, '%')
    </update>

    <update id="updateShowOrder">
        update resource_tree
        set show_order = show_order + 1
        where app_id = #{appId}
        and parent_id = #{parentId}
        and show_order >= #{targetIdx}
    </update>
</mapper>