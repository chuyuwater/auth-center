<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false" scanPeriod="10 seconds" debug="false">
    <springProperty scope="context" name="level" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="appName" source="spring.application.name"/>
    <springProperty scope="context" name="path" source="logging.file.path" defaultValue="./logs"/>

    <!-- Console 输出设置 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--格式化输出：%d表示日期，%thread表示线程名，%-5level：级别从左显示5个字符宽度%msg：日志消息，%n是换行符-->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!--服务日志文件-->
    <appender name="serviceLog" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${level}</level>
        </filter>
        <File>${path}/${appName}.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <FileNamePattern>${path}/${appName}-%d{yyyy-MM-dd}-%i.log</FileNamePattern>
            <maxHistory>15</maxHistory>
            <maxFileSize>5MB</maxFileSize>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d [%thread] [%X{trace_id}] %level %logger{36} %line - %msg%n</pattern>
        </encoder>
    </appender>

    <!--错误日志文件-->
    <appender name="errorLog" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>Warn</level>
        </filter>
        <File>${path}/${appName}-error.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <FileNamePattern>${path}/${appName}-error-%d{yyyy-MM-dd}-%i.log</FileNamePattern>
            <maxHistory>15</maxHistory>
            <maxFileSize>5MB</maxFileSize>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d [%thread] [%X{trace_id}] %level %logger{36} %line - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.alibaba.nacos.client" level="INFO" additivity="false">
        <appender-ref ref="console"/>
    </logger>
    <logger name="com.alibaba.nacos.common" level="WARN" additivity="false">
        <appender-ref ref="console"/>
    </logger>
    <logger name="com.networknt.schema" level="OFF"/>
    <logger name="org.apache.kafka.clients" level="ERROR"/>
    <logger name="io.lettuce.core.protocol" level="ERROR"/>

    <!--根日志配置-->
    <root>
        <appender-ref ref="console"/>
        <appender-ref ref="serviceLog"/>
        <appender-ref ref="errorLog"/>
    </root>
</configuration>
